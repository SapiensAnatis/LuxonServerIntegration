<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Luxon.Server" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="SharpYaml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="plugin.yml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Luxon.Server.Plugin\Luxon.Server.Plugin.csproj" />

    <ProjectReference Include="..\Luxon.Server.GluonPlugin\Luxon.Server.GluonPlugin.csproj">
      <!-- Don't reference this assembly at compile time, but build it before this project -->
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Imports\" />
  </ItemGroup>
</Project>
