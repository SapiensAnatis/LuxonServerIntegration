<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Luxon.Server" />
    <PackageReference Include="SharpYaml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="plugin.yml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Luxon.Server.Plugin\Luxon.Server.Plugin.csproj" />

    <ProjectReference Include="..\Luxon.Server.GluonPlugin\Luxon.Server.GluonPlugin.csproj">
      <!-- Don't reference this assembly at compile time, but build it before this project -->
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
</Project>
